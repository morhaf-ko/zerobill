# A user service, so zerobill uses your GitHub CLI login:
#   cp zerobill.service ~/.config/systemd/user/
#   systemctl --user enable --now zerobill
#   loginctl enable-linger "$USER"    # keep running while you are logged out
# It only logs until you add --apply to ExecStart.
[Unit]
Description=zerobill
Wants=network-online.target
After=network-online.target

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/zerobill run
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
