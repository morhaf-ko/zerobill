# Docker Compose settings. Copy to .env, keep it private, and never commit it.
GITHUB_TOKEN=
ZEROBILL_OWNER=your-org

# Only machines whose GitHub Actions runners carry this label are included.
# ZEROBILL_SELF_HOSTED_LABEL=home-ci

# Enable only after installing the Blacksmith GitHub App.
# ZEROBILL_BLACKSMITH=false

# ZEROBILL_RESERVE_PERCENT=10
# ZEROBILL_ALERT_REMAINING_PERCENT=20
# ZEROBILL_CHECK_INTERVAL=5m
# ZEROBILL_QUEUE_TIMEOUT=10m
# ZEROBILL_NOTIFY=https://ntfy.sh/your-topic
