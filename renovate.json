{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "5 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": false,
    "labels": [
      "security"
    ]
  },
  "automerge": false,
  "pinDigests": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "These update types carry no release timestamp, so a release age would never pass.",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "digest",
        "pinDigest",
        "pin",
        "replacement",
        "bump",
        "lockfileUpdate",
        "rollback"
      ],
      "minimumReleaseAge": null
    },
    {
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "breaking-change"
      ]
    },
    {
      "description": "Examples show a readable version tag for users to copy",
      "matchFileNames": [
        "examples/**"
      ],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "actionlint runs as a pinned image inside a run step.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>rhysd/actionlint):(?<currentValue>[\\w.]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
